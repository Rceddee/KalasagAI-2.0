# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.keystore
*.jks

# large binary files / downloads
*.apk
*.aab
*.ipa
/public/downloads/*.apk

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*
*.log

# env files (protect all secrets, allow template)
.env*
!.env.example
*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch / temp files
/scratch/

# firebase credentials
*-service-account*.json
service-account*.json
google-services.json
GoogleService-Info.plist
credentials.json
