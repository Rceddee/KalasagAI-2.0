rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : "";
    }

    function personnelPath() {
      return /databases/$(database)/documents/personnel/$(userEmail());
    }

    function isRootSuperAdmin() {
      return signedIn()
        && exists(personnelPath())
        && get(personnelPath()).data.role == "Super Admin";
    }

    function isPersonnel() {
      return isRootSuperAdmin()
        || (
          userEmail() != ""
          && exists(personnelPath())
          && get(personnelPath()).data.role in [
            "Admin",
            "Communication Officer",
            "Responder"
          ]
        );
    }

    function isAdmin() {
      return isRootSuperAdmin()
        || (isPersonnel() && get(personnelPath()).data.role == "Admin");
    }

    function isDispatcher() {
      return isAdmin()
        || (isPersonnel() && get(personnelPath()).data.role == "Communication Officer");
    }

    function isStaffRole(role) {
      return role in ["Responder", "Communication Officer"];
    }

    function isAssignableRole(role) {
      return isStaffRole(role) || role == "Admin";
    }

    function validPersonnelCreate(personnelId) {
      return request.resource.data.keys().hasOnly(["name", "email", "role", "registered_at"])
        && request.resource.data.keys().hasAll(["name", "email", "role", "registered_at"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.lower() == personnelId
        && request.resource.data.registered_at is string
        && isAssignableRole(request.resource.data.role);
    }

    // Reports are accepted from any location, with valid GPS coordinates.
    function hasValidCoordinates() {
      return request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180;
    }

    function verifiedAccount() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function validAiControls() {
      return request.resource.data.keys().hasOnly(["threshold", "surgeMode", "updated_at"])
        && request.resource.data.keys().hasAll(["threshold", "surgeMode", "updated_at"])
        && request.resource.data.threshold is int
        && request.resource.data.threshold >= 50
        && request.resource.data.threshold <= 95
        && request.resource.data.threshold % 5 == 0
        && request.resource.data.surgeMode is bool
        && request.resource.data.updated_at is timestamp;
    }

    function publicIncidentPath(reportId) {
      return /databases/$(database)/documents/public_incidents/$(reportId);
    }

    function publicIncidentMatchesReport(reportId) {
      let report = getAfter(/databases/$(database)/documents/incident_reports/$(reportId)).data;
      let publicIncident = getAfter(publicIncidentPath(reportId)).data;
      return publicIncident.category == report.category
        && publicIncident.secondary_category == report.secondary_category
        && publicIncident.priority_level == report.priority_level
        && publicIncident.incident_description == report.incident_description
        && publicIncident.latitude == report.latitude
        && publicIncident.longitude == report.longitude
        && publicIncident.status == report.status
        && publicIncident.report_date == report.report_date
        && publicIncident.report_id == report.report_id
        && publicIncident.blotter_id == report.blotter_id
        && publicIncident.surge_mode == report.surge_mode;
    }

    function validPublicIncident(reportId) {
      let report = getAfter(/databases/$(database)/documents/incident_reports/$(reportId)).data;
      return request.resource.data.keys().hasOnly([
          "category",
          "secondary_category",
          "priority_level",
          "incident_description",
          "latitude",
          "longitude",
          "status",
          "report_date",
          "report_id",
          "blotter_id",
          "surge_mode"
        ])
        && request.resource.data.keys().hasAll([
          "category",
          "secondary_category",
          "priority_level",
          "incident_description",
          "latitude",
          "longitude",
          "status",
          "report_date",
          "report_id",
          "blotter_id",
          "surge_mode"
        ])
        && request.resource.data.category in [
          "flooding",
          "fire incident",
          "road obstruction",
          "medical emergency",
          "other disaster-related incidents"
        ]
        && (request.resource.data.secondary_category == null
          || request.resource.data.secondary_category is string)
        && request.resource.data.priority_level in ["High", "Medium", "Low"]
        && request.resource.data.incident_description is string
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.status in ["Pending", "In Progress", "Resolved", "Closed"]
        && request.resource.data.report_date is timestamp
        && request.resource.data.report_id is string
        && request.resource.data.blotter_id is string
        && request.resource.data.surge_mode is bool
        && request.resource.data.category == report.category
        && request.resource.data.secondary_category == report.secondary_category
        && request.resource.data.priority_level == report.priority_level
        && request.resource.data.incident_description == report.incident_description
        && request.resource.data.latitude == report.latitude
        && request.resource.data.longitude == report.longitude
        && request.resource.data.status == report.status
        && request.resource.data.report_date == report.report_date
        && request.resource.data.report_id == report.report_id
        && request.resource.data.blotter_id == report.blotter_id
        && request.resource.data.surge_mode == report.surge_mode;
    }

    match /incident_reports/{reportId} {
      allow read: if isPersonnel()
        || (signedIn() && resource.data.reporter_uid == request.auth.uid);
      allow create: if (
          isAdmin()
          || (
            verifiedAccount()
            && hasValidCoordinates()
            && request.resource.data.reporter_uid == request.auth.uid
          )
        )
        && existsAfter(publicIncidentPath(reportId))
        && publicIncidentMatchesReport(reportId);
      allow update: if isDispatcher()
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["category", "priority_level", "status"])
          || publicIncidentMatchesReport(reportId)
        );
      allow delete: if isAdmin()
        && !existsAfter(publicIncidentPath(reportId));
    }

    match /public_incidents/{reportId} {
      allow read: if true;
      allow create: if (isAdmin()
          || (
            verifiedAccount()
            && getAfter(/databases/$(database)/documents/incident_reports/$(reportId)).data.reporter_uid == request.auth.uid
          ))
        && validPublicIncident(reportId);
      allow update: if isDispatcher() && validPublicIncident(reportId);
      allow delete: if isAdmin()
        && !existsAfter(/databases/$(database)/documents/incident_reports/$(reportId));
    }

    match /citizens/{citizenId} {
      allow read: if signedIn() && (request.auth.uid == citizenId || isPersonnel());
      allow create, update: if signedIn() && request.auth.uid == citizenId;
      allow delete: if false;
    }

    match /personnel/{personnelId} {
      allow read: if signedIn() && (personnelId == userEmail() || isPersonnel());

      // Super Admin records are bootstrapped through the Firebase Console, never client-created.
      allow create: if validPersonnelCreate(personnelId)
        && (
          isRootSuperAdmin()
          || (isAdmin() && isStaffRole(request.resource.data.role))
        );

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "role"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && (
          (
            isRootSuperAdmin()
            && (
              (
                resource.data.role == "Super Admin"
                && request.resource.data.role == "Super Admin"
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name"])
              )
              || (
                resource.data.role != "Super Admin"
                && isAssignableRole(request.resource.data.role)
              )
            )
          )
          || (
            isAdmin()
            && !isRootSuperAdmin()
            && isStaffRole(resource.data.role)
            && isStaffRole(request.resource.data.role)
          )
        );

      allow delete: if (
        isRootSuperAdmin()
        && resource.data.role != "Super Admin"
      ) || (
        isAdmin()
        && !isRootSuperAdmin()
        && isStaffRole(resource.data.role)
      );
    }

    match /system_logs/{logId} {
      allow read: if isDispatcher();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /system_config/{docId} {
      allow read: if signedIn();

      allow create: if docId == "report_counter"
        && signedIn()
        && request.resource.data.keys().hasOnly(["incident_count"])
        && request.resource.data.incident_count is int
        && request.resource.data.incident_count == 1;

      allow update: if docId == "report_counter"
        && signedIn()
        && request.resource.data.keys().hasOnly(["incident_count"])
        && resource.data.incident_count is int
        && request.resource.data.incident_count == resource.data.incident_count + 1;

      allow create, update: if docId == "ai_controls"
        && isAdmin()
        && validAiControls();

      allow delete: if isAdmin() && docId != "report_counter";
    }
  }
}
