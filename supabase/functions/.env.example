# Copy to .env.local. Keep all values server-side and use development-project credentials only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RESIDENT_WEB_URL=http://localhost:3001
GEMINI_ENABLED=false
# The database dispatcher uses kalasagai_ai_dispatch_anon_jwt in Vault (the project's public legacy anon JWT).
# The gateway validates the JWT. The Edge handler authenticates each delivery with the HMAC below.
# Use the same random value (at least 32 bytes) as the Vault secret; never expose it to clients.
AI_DISPATCH_HMAC_KEY=
# Choose one model per deployment. GEMINI_MODEL is supported as a legacy alias.
GEMINI_MODEL1=gemini-3.5-flash-lite
# Do not set GEMINI_API_KEY until live inference is separately authorized.
